# ======================================================
# PLACEMENT BILLING INVOICE
#
# Used when Admin / authorized Staff issues a provider
# placement billing invoice.
#
# These values are snapshotted into the invoice at issue
# time so old invoices do not change when settings change.
# ======================================================

INVOICE_ISSUER_NAME=
INVOICE_ISSUER_POSTAL_CODE=
INVOICE_ISSUER_ADDRESS=
INVOICE_ISSUER_PHONE=
INVOICE_ISSUER_EMAIL=

# Japanese qualified invoice registration number, if used.
# Example format:
# T1234567890123
#
# Leave empty if not applicable yet.
INVOICE_REGISTRATION_NUMBER=

# ======================================================
# BANK TRANSFER DETAILS
# ======================================================

INVOICE_BANK_NAME=
INVOICE_BANK_BRANCH=

# Example:
# 普通
# 当座
INVOICE_BANK_ACCOUNT_TYPE=普通

INVOICE_BANK_ACCOUNT_NUMBER=
INVOICE_BANK_ACCOUNT_HOLDER=